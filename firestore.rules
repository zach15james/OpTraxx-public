rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: read/write own doc only
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // Tasks: supervisors create/edit/delete; employees read own assigned tasks
    match /tasks/{taskId} {
      allow create, update, delete: if isSupervisor();
      allow read: if isSupervisor()
                  || (request.auth != null && resource.data.assigneeId == request.auth.uid);
    }

    // Forms: supervisors only
    match /forms/{formId} {
      allow read, write: if isSupervisor();
    }

    // Submissions: employees create their own; supervisors read all
    match /submissions/{subId} {
      allow create: if request.auth != null
                    && request.resource.data.submittedBy == request.auth.uid;
      allow read: if isSupervisor()
                  || (request.auth != null && resource.data.submittedBy == request.auth.uid);
    }

    // Teams: supervisors of that team can read/write
    match /teams/{teamId} {
      allow read, write: if isSupervisor();
    }

    function isSupervisor() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }
  }
}
