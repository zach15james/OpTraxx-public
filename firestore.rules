rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any authenticated user can read (needed for team views,
    // assignee lookups, escalation reassign picker). Write only own doc.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }

    // Tasks: supervisors create/delete; supervisors update freely; employees
    // can update their own assigned task (e.g. to mark it complete after
    // submitting the attached form). Employees read only their own.
    match /tasks/{taskId} {
      allow create, delete: if isSupervisor();
      allow update: if isSupervisor()
                    || (request.auth != null && resource.data.assigneeId == request.auth.uid);
      allow read: if isSupervisor()
                  || (request.auth != null && resource.data.assigneeId == request.auth.uid);
    }

    // Forms: any authenticated user can read (employees need to fill them);
    // only supervisors can write.
    match /forms/{formId} {
      allow read: if request.auth != null;
      allow write: if isSupervisor();
    }

    // Submissions: employees create their own; supervisors read all
    match /submissions/{subId} {
      allow create: if request.auth != null
                    && request.resource.data.submittedBy == request.auth.uid;
      allow read: if isSupervisor()
                  || (request.auth != null && resource.data.submittedBy == request.auth.uid);
    }

    // Teams: supervisors of that team can read/write
    match /teams/{teamId} {
      allow read, write: if isSupervisor();
    }

    // Nudges: anyone auth can send (fromUid must be self); recipient and
    // sender can read; recipient can update (mark as read).
    match /nudges/{nudgeId} {
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
      allow read: if request.auth != null
                  && (resource.data.toUid == request.auth.uid
                      || resource.data.fromUid == request.auth.uid);
      allow update: if request.auth != null
                    && resource.data.toUid == request.auth.uid;
    }

    function isSupervisor() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }
  }
}
